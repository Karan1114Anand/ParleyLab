# ParleyLab Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Optional overrides ────────────────────────────────────────────────────────
PARLEYLAB_LLM_PROVIDER=gemini
PARLEYLAB_MODEL=gemini-2.0-flash

# Path to the trained PPO model zip (default: auto-detected from project root)
# RL_MODEL_PATH=../models/best_model.zip

# Ollama base URL (only needed if using ollama provider)
# OLLAMA_BASE_URL=http://localhost:11434
# PARLEYLAB_OPPONENT_MODEL=llama3.1:8b
# PARLEYLAB_CRITIC_MODEL=qwen2.5:7b
# PARLEYLAB_PARSER_MODEL=qwen2.5:7b
