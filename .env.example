# ParleyLab — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── LLM provider — pick ONE block below ───────────────────────────────────────

# Option A: Gemini (default) — https://aistudio.google.com/apikey
PARLEYLAB_LLM_PROVIDER=gemini
PARLEYLAB_MODEL=gemini-2.0-flash-lite

# Option B: Groq (free, fast, higher rate limits) — https://console.groq.com/keys
# PARLEYLAB_LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# PARLEYLAB_MODEL=llama-3.1-8b-instant
# Other Groq models: llama-3.3-70b-versatile, gemma2-9b-it, mixtral-8x7b-32768

# Option C: Ollama (local, no API key needed)
# PARLEYLAB_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# PARLEYLAB_MODEL=llama3.1:8b

# ── Optional overrides ────────────────────────────────────────────────────────
# Path to the trained PPO model (auto-detected from project root if unset)
# RL_MODEL_PATH=../models/best_model.zip
